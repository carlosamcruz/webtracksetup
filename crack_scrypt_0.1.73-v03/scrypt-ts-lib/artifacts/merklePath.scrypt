
struct Node {
  Sha256 hash;
  int pos;
}

library MerklePath {
  static const int DEPTH = 32;
  static const int INVALID_NODE = 0;
  static const int LEFT_NODE = 1;
  static const int RIGHT_NODE = 2;
  static function calcMerkleRoot(Sha256 leaf, Node[32] merkleProof) : Sha256 {
    Sha256 root = leaf;
    loop (32) : i {
        Node node = merkleProof[i];
        if(node.pos != 0) {
          root = node.pos == 1 ? Sha256(hash256(node.hash + root)) : Sha256(hash256(root + node.hash));
        }
      }
    return root;
  }
  static function isCoinbase(Node[32] merkleproof) : bool {
    bool res = true;
    loop (32) : i {
        Node node = merkleproof[i];
        if(node.pos != 0) {
          res = res && node.pos == 2;
        }
      }
    return res;
  }
}