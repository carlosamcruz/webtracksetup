struct __scrypt_ts_Change {  int amount;  Ripemd160 address;}

contract GeneralTokenV2 {
  const bytes tokenType;
  @state bytes prevUtxo;
  const int totalSupply;
  const bytes idData;
  @state Ripemd160 alice;
  @state bytes data;
  @state bool sell;
  @state int price;
  @state int thisSupply;
  @state Ripemd160 toBuyer;
  @state bytes branch;
  @state int nTxThisBranch;
  @state bytes genesisTX;
  bytes __scrypt_ts_ctx_hashprevouts;
  bytes __scrypt_ts_ctx_hashoutputs;
  int __scrypt_ts_ctx_value;
  __scrypt_ts_Change __scrypt_ts_change;
  bytes __scrypt_ts_prevouts;
  constructor(Ripemd160 alice, int totalSupply, bytes idData, bytes prevUtxo) {
    this.totalSupply = totalSupply;
    this.idData = idData;
    this.thisSupply = this.totalSupply;
    this.alice = alice;
    this.data = b'';
    this.sell = false;
    this.price = 0;
    this.toBuyer = this.alice;
    this.prevUtxo = prevUtxo;
    this.genesisTX = b'';
    this.tokenType = b'47656e6572616c20507572706f736520546f6b656e';
    this.branch = b'00';
    this.nTxThisBranch = 0;
  }
  public function setupToken(Sig sig, PubKey pubkey, bool finish, bytes newData, bytes utxoReserved, bytes tx1P1, bytes tx1P2, bytes tx1P3, bytes tx1P4, bytes tx1P5, SigHashPreimage __scrypt_ts_txPreimage, int __scrypt_ts_changeAmount, Ripemd160 __scrypt_ts_changeAddress, bytes __scrypt_ts_prevouts) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'41')));
    this.__scrypt_ts_ctx_hashprevouts = SigHash.hashPrevouts(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    this.__scrypt_ts_change = {__scrypt_ts_changeAmount, __scrypt_ts_changeAddress};
    require(hash256(__scrypt_ts_prevouts) == this.__scrypt_ts_ctx_hashprevouts);
    this.__scrypt_ts_prevouts = __scrypt_ts_prevouts;
    require(hash160(pubkey) == this.alice);
    require(checkSig(sig, pubkey));
    bytes UTXO1 = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    bytes txidPrv = b'';
    if(len(this.prevUtxo) == 36) {
        txidPrv = hash256(tx1P1 + this.prevUtxo + tx1P2 + UTXO1 + tx1P5);
      } else {
        txidPrv = hash256(tx1P1 + this.prevUtxo[0 : 36] + tx1P2 + this.prevUtxo[36 : 72] + tx1P3 + UTXO1 + tx1P5);
      }
    
    
    
    
    
    require(this.__scrypt_ts_prevouts[0 : 32] == txidPrv);
    bytes outputs = b'';
    if(finish) {
        outputs = Utils.buildOutput(Utils.buildPublicKeyHashScript(this.alice), this.__scrypt_ts_ctx_value);
      } else {
        this.genesisTXverify();
        
        this.nTxThisBranch = this.nTxThisBranch + 1;
        this.prevUtxo = this.__scrypt_ts_prevouts[0 : 36];
        
        this.data = newData;
        outputs = this.buildStateOutput(this.__scrypt_ts_ctx_value);
        
      }
    if(utxoReserved != b'') {
        outputs += utxoReserved;
      }
    if(this.__scrypt_ts_change.amount > 0) {
        outputs += this.buildChangeOutput();
      }
    require(this.__scrypt_ts_ctx_hashoutputs == hash256(outputs));
  }
  public function sellOrder(Sig sig, PubKey pubkey, bool sell, int price, Ripemd160 toBuyer, bytes utxoReserved, bytes tx1P1, bytes tx1P2, bytes tx1P3, bytes tx1P4, bytes tx1P5, SigHashPreimage __scrypt_ts_txPreimage, int __scrypt_ts_changeAmount, Ripemd160 __scrypt_ts_changeAddress, bytes __scrypt_ts_prevouts) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'41')));
    this.__scrypt_ts_ctx_hashprevouts = SigHash.hashPrevouts(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    this.__scrypt_ts_change = {__scrypt_ts_changeAmount, __scrypt_ts_changeAddress};
    require(hash256(__scrypt_ts_prevouts) == this.__scrypt_ts_ctx_hashprevouts);
    this.__scrypt_ts_prevouts = __scrypt_ts_prevouts;
    require(hash160(pubkey) == this.alice);
    require(checkSig(sig, pubkey));
    require((this.sell || sell) && !(this.sell && sell));
    bytes UTXO1 = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    bytes txidPrv = b'';
    if(len(this.prevUtxo) == 36) {
        txidPrv = hash256(tx1P1 + this.prevUtxo + tx1P2 + UTXO1 + tx1P5);
      } else {
        txidPrv = hash256(tx1P1 + this.prevUtxo[0 : 36] + tx1P2 + this.prevUtxo[36 : 72] + tx1P3 + UTXO1 + tx1P5);
      }
    
    
    
    
    
    require(this.__scrypt_ts_prevouts[0 : 32] == txidPrv);
    this.genesisTXverify();
    this.nTxThisBranch = this.nTxThisBranch + 1;
    this.prevUtxo = this.__scrypt_ts_prevouts[0 : 36];
    
    this.sell = sell;
    if(sell) {
        this.price = price;
        this.toBuyer = toBuyer;
      } else {
        this.price = 0;
        this.toBuyer = this.alice;
      }
    bytes outputs = b'';
    outputs = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    if(this.toBuyer != this.alice) {
        outputs += Utils.buildOutput(Utils.buildPublicKeyHashScript(this.toBuyer), 1);
      }
    if(utxoReserved != b'') {
        outputs += utxoReserved;
      }
    if(this.__scrypt_ts_change.amount > 0) {
        outputs += this.buildChangeOutput();
      }
    require(this.__scrypt_ts_ctx_hashoutputs == hash256(outputs));
  }
  public function buying(Ripemd160 newOwner, int price, bytes utxoReserved, bytes tx1P1, bytes tx1P2, bytes tx1P3, bytes tx1P4, bytes tx1P5, SigHashPreimage __scrypt_ts_txPreimage, int __scrypt_ts_changeAmount, Ripemd160 __scrypt_ts_changeAddress, bytes __scrypt_ts_prevouts) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'41')));
    this.__scrypt_ts_ctx_hashprevouts = SigHash.hashPrevouts(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    this.__scrypt_ts_change = {__scrypt_ts_changeAmount, __scrypt_ts_changeAddress};
    require(hash256(__scrypt_ts_prevouts) == this.__scrypt_ts_ctx_hashprevouts);
    this.__scrypt_ts_prevouts = __scrypt_ts_prevouts;
    require(this.sell);
    require(price >= this.price);
    if(this.toBuyer != this.alice) {
        require(this.toBuyer == newOwner);
      }
    require(newOwner != this.alice);
    bytes UTXO1 = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    bytes txidPrv = b'';
    if(len(this.prevUtxo) == 36) {
        txidPrv = hash256(tx1P1 + this.prevUtxo + tx1P2 + UTXO1 + tx1P5);
      } else {
        txidPrv = hash256(tx1P1 + this.prevUtxo[0 : 36] + tx1P2 + this.prevUtxo[36 : 72] + tx1P3 + UTXO1 + tx1P5);
      }
    
    
    
    
    
    require(this.__scrypt_ts_prevouts[0 : 32] == txidPrv);
    this.genesisTXverify();
    this.nTxThisBranch = this.nTxThisBranch + 1;
    this.prevUtxo = this.__scrypt_ts_prevouts[0 : 36];
    
    bytes outputs = b'';
    if(this.sell) {
        Ripemd160 lastAlice = this.alice;
        this.alice = newOwner;
        this.sell = false;
        this.price = 0;
        outputs = this.buildStateOutput(this.__scrypt_ts_ctx_value);
        outputs += Utils.buildOutput(Utils.buildPublicKeyHashScript(lastAlice), price);
      }
    if(utxoReserved != b'') {
        outputs += utxoReserved;
      }
    if(this.__scrypt_ts_change.amount > 0) {
        outputs += this.buildChangeOutput();
      }
    require(this.__scrypt_ts_ctx_hashoutputs == hash256(outputs));
  }
  public function split(Sig sig, PubKey pubkey, int numberOfSendTokens, Ripemd160 toNewOwner, bytes utxoReserved, bytes tx1P1, bytes tx1P2, bytes tx1P3, bytes tx1P4, bytes tx1P5, SigHashPreimage __scrypt_ts_txPreimage, int __scrypt_ts_changeAmount, Ripemd160 __scrypt_ts_changeAddress, bytes __scrypt_ts_prevouts) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'41')));
    this.__scrypt_ts_ctx_hashprevouts = SigHash.hashPrevouts(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    this.__scrypt_ts_change = {__scrypt_ts_changeAmount, __scrypt_ts_changeAddress};
    require(hash256(__scrypt_ts_prevouts) == this.__scrypt_ts_ctx_hashprevouts);
    this.__scrypt_ts_prevouts = __scrypt_ts_prevouts;
    require(numberOfSendTokens <= this.thisSupply);
    require(hash160(pubkey) == this.alice);
    require(checkSig(sig, pubkey));
    bytes UTXO1 = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    bytes txidPrv = b'';
    if(len(this.prevUtxo) == 36) {
        txidPrv = hash256(tx1P1 + this.prevUtxo + tx1P2 + UTXO1 + tx1P5);
      } else {
        txidPrv = hash256(tx1P1 + this.prevUtxo[0 : 36] + tx1P2 + this.prevUtxo[36 : 72] + tx1P3 + UTXO1 + tx1P5);
      }
    
    
    
    
    
    require(this.__scrypt_ts_prevouts[0 : 32] == txidPrv);
    this.genesisTXverify();
    this.prevUtxo = this.__scrypt_ts_prevouts[0 : 36];
    
    bytes outputs1 = b'';
    bytes outputs = b'';
    if(this.thisSupply == numberOfSendTokens) {
        this.nTxThisBranch = this.nTxThisBranch + 1;
        this.alice = toNewOwner;
        outputs = this.buildStateOutput(this.__scrypt_ts_ctx_value);
        outputs += Utils.buildOutput(Utils.buildPublicKeyHashScript(this.alice), 1);
      } else {
        bytes branch00 = this.branch + b'01' + num2bin(len(pack(this.nTxThisBranch)), 1) + pack(this.nTxThisBranch);
        this.branch = this.branch + b'02' + num2bin(len(pack(this.nTxThisBranch)), 1) + pack(this.nTxThisBranch);
        this.nTxThisBranch = 0;
        this.thisSupply = this.thisSupply - numberOfSendTokens;
        outputs1 = this.buildStateOutput(this.__scrypt_ts_ctx_value);
        this.alice = toNewOwner;
        this.thisSupply = numberOfSendTokens;
        this.branch = branch00;
        outputs = this.buildStateOutput(this.__scrypt_ts_ctx_value) + outputs1;
        outputs += Utils.buildOutput(Utils.buildPublicKeyHashScript(this.alice), 1);
      }
    if(utxoReserved != b'') {
        outputs += utxoReserved;
      }
    if(this.__scrypt_ts_change.amount > 0) {
        outputs += this.buildChangeOutput();
      }
    require(this.__scrypt_ts_ctx_hashoutputs == hash256(outputs));
  }
  public function mergeTokens(Sig sig, PubKey pubkey, int Supply1, int Supply2, int nTxThisBranch1, int nTxThisBranch2, bytes branch1, bytes branch2, bytes utxoReserved, bytes tx1P1, bytes tx1P2, bytes tx1P3, bytes tx1P4, bytes tx1P5, SigHashPreimage __scrypt_ts_txPreimage, int __scrypt_ts_changeAmount, Ripemd160 __scrypt_ts_changeAddress, bytes __scrypt_ts_prevouts) {
    require(Tx.checkPreimageSigHashType(__scrypt_ts_txPreimage, SigHashType(b'41')));
    this.__scrypt_ts_ctx_hashprevouts = SigHash.hashPrevouts(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_hashoutputs = SigHash.hashOutputs(__scrypt_ts_txPreimage);
    this.__scrypt_ts_ctx_value = SigHash.value(__scrypt_ts_txPreimage);
    this.__scrypt_ts_change = {__scrypt_ts_changeAmount, __scrypt_ts_changeAddress};
    require(hash256(__scrypt_ts_prevouts) == this.__scrypt_ts_ctx_hashprevouts);
    this.__scrypt_ts_prevouts = __scrypt_ts_prevouts;
    require(hash160(pubkey) == this.alice);
    require(checkSig(sig, pubkey));
    bytes UTXO1 = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    bytes txidPrv = b'';
    if(len(this.prevUtxo) == 36) {
        txidPrv = hash256(tx1P1 + this.prevUtxo + tx1P2 + UTXO1 + tx1P5);
      } else {
        txidPrv = hash256(tx1P1 + this.prevUtxo[0 : 36] + tx1P2 + this.prevUtxo[36 : 72] + tx1P3 + UTXO1 + tx1P5);
      }
    
    
    
    
    
    require(this.__scrypt_ts_prevouts[0 : 32] == txidPrv);
    this.genesisTXverify();
    if(len(this.__scrypt_ts_prevouts) > 72) this.prevUtxo = this.__scrypt_ts_prevouts[0 : 72]; else this.prevUtxo = this.__scrypt_ts_prevouts[0 : 36];
    
    bytes outputs = b'';
    this.thisSupply = Supply1 + Supply2;
    if(len(branch1) < len(branch2)) {
        this.branch = branch1;
        this.nTxThisBranch = nTxThisBranch1;
      } else {
        this.branch = branch2;
        this.nTxThisBranch = nTxThisBranch2;
        nTxThisBranch2 = nTxThisBranch1;
      }
    this.branch = this.branch + b'03' + num2bin(len(pack(this.nTxThisBranch)), 1) + pack(this.nTxThisBranch) + num2bin(len(pack(nTxThisBranch2)), 1) + pack(nTxThisBranch2);
    this.nTxThisBranch = 0;
    outputs = this.buildStateOutput(this.__scrypt_ts_ctx_value);
    outputs += Utils.buildOutput(Utils.buildPublicKeyHashScript(this.alice), this.__scrypt_ts_ctx_value);
    if(utxoReserved != b'') {
        outputs += utxoReserved;
      }
    if(this.__scrypt_ts_change.amount > 0) {
        outputs += this.buildChangeOutput();
      }
    require(this.__scrypt_ts_ctx_hashoutputs == hash256(outputs));
  }
  function genesisTXverify() : bool {
    if(this.genesisTX == b'') {
        this.genesisTX = reverseBytes(this.__scrypt_ts_prevouts[0 : 32], 32);
      }
    return true;
  }
  function buildStateOutput(int amount) : bytes {  return Utils.buildOutput(this.getStateScript(), amount);}
  function buildChangeOutput() : bytes {  return this.__scrypt_ts_change.amount > 0 ? Utils.buildOutput(Utils.buildPublicKeyHashScript(this.__scrypt_ts_change.address), this.__scrypt_ts_change.amount) : b'';}
}